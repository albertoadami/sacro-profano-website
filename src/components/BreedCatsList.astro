---
import CatCard from './CatCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  breed: 'Sacro di Birmania' | 'Kurilian Bobtail';
  lang?: Lang;
}
const { breed, lang = 'it' } = Astro.props;
const t = useTranslations(lang);
const breedersPath = lang === 'it' ? '/breeders' : '/en/breeders';

const cats = (await getCollection(lang === 'it' ? 'cats' : 'catsEn', (c) => c.data.breed === breed))
  .sort((a, b) => a.data.order - b.data.order);
---
{cats.length > 0 ? (
  <div class="grid">
    {cats.map((cat) => (
      <CatCard
        name={cat.data.name}
        breed={cat.data.breed}
        color={cat.data.color}
        titles={cat.data.titles}
        coverImage={cat.data.coverImage}
        href={`${breedersPath}/${cat.slug}`}
        lang={lang}
      />
    ))}
  </div>
) : (
  <p><em>{t('breeders.empty')}</em></p>
)}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }
</style>
