---
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Allevamento amatoriale Sacro e Profano Cattery' } = Astro.props;
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} · Sacro e Profano Cattery</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/worksans-variable.woff2" as="font" type="font/woff2" crossorigin />
  <SpeedInsights />
  <Analytics />
</head>
<body>
  <header class="site-header">
    <a href="/" class="wordmark">
      <span class="sacro">Sacro</span> <span class="rest">e Profano</span>
    </a>
    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Apri il menu"
    >
      <span class="menu-toggle-bar"></span>
      <span class="menu-toggle-bar"></span>
      <span class="menu-toggle-bar"></span>
    </button>
    <nav id="site-nav">
      <a href="/">Home</a>
      <a href="/about-us">Chi siamo</a>
      <a href="/sacro-di-birmania">Sacro di Birmania</a>
      <a href="/kurilian-bobtail">Kurilian Bobtail</a>
      <a href="/breeders">Riproduttori</a>
      <a href="/litters">Cucciolate</a>
      <a href="/contact">Contatti</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <a href="/" class="wordmark footer-wordmark">
      <span class="sacro">Sacro</span> <span class="rest">e Profano</span>
    </a>
    <nav class="social-links" aria-label="Social">
      <a href="https://www.facebook.com/profile.php?id=100057880110518&locale=it_IT" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M13.5 21v-7.5h2.5l.5-3h-3V8.25c0-.87.24-1.46 1.49-1.46H16.5V4.14C16.24 4.1 15.36 4 14.33 4c-2.15 0-3.63 1.31-3.63 3.72V10.5H8.5v3H10.7V21h2.8Z" />
        </svg>
      </a>
      <a href="https://www.instagram.com/sacroeprofanocattery/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M12 2c2.72 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47.66.26 1.22.6 1.77 1.15.55.55.9 1.11 1.15 1.77.25.64.42 1.37.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.64.25-1.37.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43.26-.66.6-1.22 1.15-1.77A4.9 4.9 0 0 1 5.45.53C6.09.28 6.82.11 7.88.06 8.94.01 9.28 0 12 0Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.25a3.25 3.25 0 1 1 0-6.5 3.25 3.25 0 0 1 0 6.5ZM17.4 4.6a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4Z" transform="translate(0 2)" />
        </svg>
      </a>
    </nav>
    <p>&copy; {new Date().getFullYear()} Sacro e Profano Cattery</p>
  </footer>

  <style is:global>
    @font-face {
      font-family: 'Fraunces';
      font-style: normal;
      font-weight: 300 900;
      font-display: swap;
      src: url('/fonts/fraunces-variable.woff2') format('woff2');
    }
    @font-face {
      font-family: 'Fraunces Italic';
      font-style: italic;
      font-weight: 500;
      font-display: swap;
      src: url('/fonts/fraunces-italic.woff') format('woff');
    }
    @font-face {
      font-family: 'Work Sans';
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url('/fonts/worksans-variable.woff2') format('woff2');
    }

    :root {
      /* Shared neutrals: warm limestone, evokes temple stone and island rock alike */
      --stone: #eae3d6;
      --paper: #f5f1e7;
      --paper-2: #ede6d7;
      --ink: #2b2521;
      --ink-soft: #55493f;
      --line: #d9cfbc;

      /* Sacro (Sacro di Birmania): temple-blue, the breed's own eye color */
      --sacro: #2f4c74;
      --sacro-soft: #e3e9f1;

      /* Profano (Kurilian Bobtail): volcanic-island ember */
      --profano: #a8552b;
      --profano-soft: #f1e2d5;

      /* Gilt accent, used sparingly for "sacred" dividers/marks */
      --brass: #9c7a3e;

      --shadow: 0 1px 2px rgba(43, 37, 33, 0.06), 0 8px 24px -12px rgba(43, 37, 33, 0.22);

      --font-display: 'Fraunces', ui-serif, Georgia, serif;
      --font-display-italic: 'Fraunces Italic', ui-serif, Georgia, serif;
      --font-body: 'Work Sans', ui-sans-serif, system-ui, sans-serif;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme='light']) {
        --stone: #2b2219;
        --paper: #34291e;
        --paper-2: #3c3024;
        --ink: #f2e8d9;
        --ink-soft: #cbb99f;
        --line: #4c3d2c;
        --sacro: #9bb8e3;
        --sacro-soft: #33445c;
        --profano: #e5975f;
        --profano-soft: #4a3624;
        --brass: #d3b378;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.25), 0 12px 32px -14px rgba(0, 0, 0, 0.45);
      }
    }

    * { box-sizing: border-box; }
    :root { color-scheme: light dark; }
    body {
      font-family: var(--font-body);
      background: var(--stone);
      color: var(--ink);
      margin: 0;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3 { font-family: var(--font-display); font-weight: 700; margin: 0 0 0.6em; text-wrap: balance; }
    a { color: inherit; }
    a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
      outline: 2px solid var(--sacro);
      outline-offset: 3px;
    }

    .wordmark {
      font-size: 1.15rem;
      line-height: 1;
      white-space: nowrap;
      text-decoration: none;
    }
    .wordmark .sacro {
      font-family: var(--font-display-italic);
      font-style: italic;
      font-weight: 500;
      color: var(--sacro);
    }
    .wordmark .rest { font-family: var(--font-display); font-weight: 800; }

    .site-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 1rem 2rem; flex-wrap: wrap; gap: 0.5rem 1.5rem;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
    }
    .site-header nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
    .site-header nav a {
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--ink-soft);
      border-bottom: 1px solid transparent;
      padding-bottom: 0.15rem;
    }
    .site-header nav a:hover { color: var(--ink); border-color: var(--brass); }

    .menu-toggle {
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: stretch;
      gap: 5px;
      width: 2.25rem;
      height: 2.25rem;
      padding: 0;
      border: none;
      background: transparent;
      cursor: pointer;
      z-index: 101;
    }
    .menu-toggle-bar {
      display: block;
      width: 100%;
      height: 2px;
      background: var(--ink);
      border-radius: 1px;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(2) { opacity: 0; }
    .menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    @media (max-width: 700px) {
      .site-header { position: relative; z-index: 101; }
      .menu-toggle { display: flex; }
      .site-header nav {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.75rem;
        background: var(--paper);
        transform: translateX(100%);
        transition: transform 0.25s ease;
        z-index: 100;
      }
      .site-header nav.open { transform: translateX(0); }
      .site-header nav a { font-size: 1.15rem; }
      body.nav-open { overflow: hidden; }
    }

    main { max-width: 1100px; margin: 0 auto; padding: 2rem; }

    .site-footer {
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 0.75rem 1.5rem;
      padding: 2rem;
      border-top: 1px solid var(--line);
    }
    .site-footer p { font-size: 0.88rem; color: var(--ink-soft); }
    .footer-wordmark { font-size: 1rem; }

    .social-links { display: flex; gap: 1rem; }
    .social-links a {
      display: flex;
      color: var(--ink-soft);
      transition: color 0.15s ease;
    }
    .social-links a:hover { color: var(--brass); }
  </style>

  <script>
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('site-nav');

    if (toggle && nav) {
      const closeNav = () => {
        nav.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('nav-open');
      };

      const openNav = () => {
        nav.classList.add('open');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.classList.add('nav-open');
      };

      toggle.addEventListener('click', () => {
        const isOpen = nav.classList.contains('open');
        isOpen ? closeNav() : openNav();
      });

      nav.addEventListener('click', (event) => {
        if (event.target instanceof HTMLAnchorElement) closeNav();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeNav();
      });
    }
  </script>
</body>
</html>
