---
import Layout from '../../layouts/Layout.astro';
import CatCard from '../../components/CatCard.astro';
import { getCollection } from 'astro:content';
import { BREEDS } from '../../content/config';
import { useTranslations, breedLabels } from '../../i18n/ui';

const t = useTranslations('en');
const allCats = await getCollection('catsEn');
const groups = BREEDS.map((breed) => ({
  breed,
  cats: allCats.filter((c) => c.data.breed === breed).sort((a, b) => a.data.order - b.data.order),
}));
---
<Layout title={t('breeders.title')} lang="en" description="Our Sacred Birman and Kurilian Bobtail cats.">
  <h1>{t('breeders.title')}</h1>
  <div class="rule"></div>

  {groups.map((group) => (
    <section class={`breed-group ${group.breed === 'Sacro di Birmania' ? 'sacro' : 'profano'}`}>
      <h2>{breedLabels.en[group.breed]}</h2>
      {group.cats.length > 0 ? (
        <div class="grid">
          {group.cats.map((cat) => (
            <CatCard
              name={cat.data.name}
              breed={cat.data.breed}
              color={cat.data.color}
              titles={cat.data.titles}
              coverImage={cat.data.coverImage}
              href={`/en/breeders/${cat.slug}`}
              lang="en"
            />
          ))}
        </div>
      ) : (
        <p><em>{t('breeders.empty')}</em></p>
      )}
    </section>
  ))}
</Layout>

<style>
  .rule {
    height: 2px;
    width: 6rem;
    margin: 1rem 0 0.5rem;
    background: linear-gradient(90deg, var(--brass), transparent 90%);
  }
  .breed-group { margin-top: 2.5rem; }
  .breed-group h2 { display: inline-block; padding-bottom: 0.3rem; border-bottom: 2px solid var(--sacro); }
  .breed-group.profano h2 { border-bottom-color: var(--profano); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }
</style>
