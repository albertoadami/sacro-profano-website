---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contatti">
  <h1>Contatti</h1>
  <div class="rule"></div>
  <p>
    Per informazioni su cuccioli disponibili, cucciolate future o per qualsiasi domanda,
    scrivici tramite il form o contattaci direttamente.
  </p>

  <div class="contact-info">
    <p class="contact-name">Sacro e Profano</p>
    <p>Allevamento Kurilian Bobtail e Sacri di Birmania</p>
    <p>di Diego Norbedo e Diana Di Natale</p>
    <p>Trieste – Italia</p>
    <p>Cellulare Diego: <a href="tel:+393357685734">(+39) 335-7685734</a></p>
    <p>Cellulare Diana: <a href="tel:+393478491253">(+39) 347-8491253</a></p>
    <p>E-mail: <a href="mailto:info@sacroeprofanocattery.com">info@sacroeprofanocattery.com</a></p>
  </div>

  <!--
    Sostituisci YOUR_FORM_ID con l'ID ottenuto creando un form gratuito su https://formspree.io
    Nessun backend necessario: Formspree gestisce l'invio email e lo spam.
  -->
  <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="contact-form">
    <label>
      Nome
      <input type="text" name="name" required />
    </label>
    <label>
      Email
      <input type="email" name="email" required />
    </label>
    <label>
      Messaggio
      <textarea name="message" rows="5" required></textarea>
    </label>
    <button type="submit">Invia</button>
  </form>
</Layout>

<style>
  .rule {
    height: 2px;
    width: 6rem;
    margin: 1rem 0 1.75rem;
    background: linear-gradient(90deg, var(--brass), transparent 90%);
  }
  .contact-info { margin: 1.5rem 0; color: var(--ink-soft); }
  .contact-info p { margin: 0.2rem 0; }
  .contact-info .contact-name { font-family: var(--font-display); font-weight: 700; color: var(--ink); font-size: 1.1rem; }
  .contact-info a { color: var(--sacro); text-decoration: none; }
  .contact-info a:hover { text-decoration: underline; }
  .contact-form { display: grid; gap: 1rem; max-width: 480px; margin-top: 1.5rem; }
  .contact-form label { display: grid; gap: 0.35rem; font-size: 0.9rem; font-weight: 500; }
  .contact-form input, .contact-form textarea {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-family: inherit;
    background: var(--paper);
    color: var(--ink);
  }
  .contact-form button {
    padding: 0.75rem;
    border: none;
    border-radius: 6px;
    background: var(--sacro);
    color: var(--paper);
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
  }
  .contact-form button:hover { background: var(--profano); }
</style>
